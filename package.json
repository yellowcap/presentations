{
  "name": "slidev-demo",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "npm run build:gnw -- --base /gnw/ && npm run build:mcp-runtime -- --base /mcp-runtime/ && npm run build:genai4earth -- --base /genai4earth/ && npm run build:index",
    "build:gnw": "slidev build decks/gnw/slides.md --out ../../dist/gnw",
    "build:mcp-runtime": "slidev build decks/mcp-runtime/slides.md --out ../../dist/mcp-runtime",
    "build:genai4earth": "slidev build decks/genai4earth/slides.md --out ../../dist/genai4earth",
    "build:index": "mkdir -p dist && cp site/index.html site/favicon.png site/logo.png site/logo-dark.png dist/",
    "dev": "slidev decks/gnw/slides.md --open",
    "dev:mcp-runtime": "slidev decks/mcp-runtime/slides.md --open",
    "dev:genai4earth": "slidev decks/genai4earth/slides.md --open",
    "dev:theme-showcase": "slidev decks/theme-showcase/slides.md --open",
    "dev:original": "slidev decks/original/slides.md --open",
    "export": "slidev export"
  },
  "dependencies": {
    "@slidev/cli": "^52.6.0",
    "@slidev/theme-default": "latest",
    "@slidev/theme-seriph": "latest",
    "slidev-addon-qrcode": "^1.0.2",
    "vue": "^3.5.22"
  }
}
